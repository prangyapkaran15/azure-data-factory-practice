{
	"name": "datasetCSV",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_filename": {
				"type": "string",
				"defaultValue": "customers_dummy.csv"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().p_filename",
					"type": "Expression"
				},
				"folderPath": "raw",
				"fileSystem": "data"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "customer_id",
				"type": "String"
			},
			{
				"name": "customer_name",
				"type": "String"
			},
			{
				"name": "city",
				"type": "String"
			},
			{
				"name": "country",
				"type": "String"
			},
			{
				"name": "email",
				"type": "String"
			},
			{
				"name": "annual_income_sek",
				"type": "String"
			}
		]
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}